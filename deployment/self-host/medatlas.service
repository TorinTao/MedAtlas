[Unit]
Description=MedAtlas personal research site
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/coding/med-atlas
Environment=PATH=/home/ubuntu/.local/opt/node-v22.23.4-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=MEDATLAS_CONFIG=/home/ubuntu/.config/medatlas/config.json
ExecStart=/home/ubuntu/.local/opt/node-v22.23.4-linux-x64/bin/node deployment/self-host/server.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/coding/medatlas-data
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=384M
MemoryMax=640M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
